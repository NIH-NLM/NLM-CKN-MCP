/* ============================================================================
   NLM-CKN — per-tissue knowledge-base summary
   Grouped on the INPUT anatomical structure (CSD.anatomical_structure) = the
   original 10 organs. No UBERON sub-part traversal, so atlas datasets are NOT
   double-counted and rows sum to the curated dataset total (e.g. 84).

   Run in the ArangoDB workspace query editor / arangosh / _api/cursor.
   Bind var:  { "graph": "<your named graph>" }
   (If you don't use a named graph, replace `GRAPH @graph` with an explicit
    edge-collection list, e.g.  `CSD-PUB, CS-CSD, CS-UBERON, ...` .)

   Edge directions verified against the loaded graph:
     CSD -[WASATTRIBUTEDTO]-> PUB     dataset  -> publication   (OUTBOUND from CSD)
     CS  -[MEMBER_OF]->       CSD     cell set -> dataset       (INBOUND  to  CSD)
     CS  -[DERIVES_FROM]->    UBERON  cell set -> tissue
   disease_status is a STRING FIELD on CSD (e.g. "normal"), NOT a MONDO node.

   NOTE on grouping: if this returns MORE than 10 rows, the loaded CSDs carry
   the *specific* tissue (e.g. "lung") rather than the organ bucket
   ("respiratory system"). In that case add a normalization map — see the
   commented block at the bottom.
   ============================================================================ */


/* ---- Query A — datasets, publications, cell sets, diseases (solid) -------- */
FOR d IN CSD
  COLLECT tissue = d.anatomical_structure INTO grp = d
  LET datasets = LENGTH(grp)
  LET publications = LENGTH(UNIQUE(
      FOR ds IN grp
        FOR p IN 1..1 OUTBOUND ds._id GRAPH @graph
          FILTER IS_SAME_COLLECTION('PUB', p)
          RETURN p._id))
  LET cell_sets = LENGTH(UNIQUE(
      FOR ds IN grp
        FOR c IN 1..1 INBOUND ds._id GRAPH @graph
          FILTER IS_SAME_COLLECTION('CS', c)
          RETURN c._id))
  LET diseases = LENGTH(UNIQUE(grp[*].disease_status))                 /* includes "normal" */
  LET diseases_excl_normal = LENGTH(UNIQUE(
      grp[* FILTER CURRENT.disease_status != 'normal'].disease_status))
  SORT tissue
  RETURN {
    tissue, datasets, publications, cell_sets,
    diseases, diseases_excl_normal
  }


/* ============================================================================
   Query B — compounds per tissue.
   Compounds (CHEMBL / CHEBI) are NOT attached to datasets or cell sets
   directly; they sit in the gene/protein layer. Run the ONE-TIME diagnostic
   first to learn the real hop path, then set the depth range in the aggregate.
   ============================================================================ */

